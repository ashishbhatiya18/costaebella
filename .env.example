# Postgres
POSTGRES_USER=attendance
POSTGRES_PASSWORD=attendance
POSTGRES_DB=attendance
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgres://attendance:attendance@localhost:5432/attendance?sslmode=disable
# Optional: production connection string, used only by `task db:sync-from-prod`
# to pull a read-only dump of prod down into your local Postgres. Never
# written to — the dump session is forced read-only (see Taskfile.yml).
# PROD_DATABASE_URL=postgres://user:password@prod-host:5432/attendance?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
# Optional: seeds one whitelisted admin email on startup (Google login only, no password)
ADMIN_EMAIL=admin@example.com
GOOGLE_CLIENT_ID=719888124802-ap7f2ldmvj76791i944k7e47dv7dhin1.apps.googleusercontent.com

ALLOWED_ORIGINS=http://localhost:3000
PORT=8080

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_GOOGLE_CLIENT_ID=719888124802-ap7f2ldmvj76791i944k7e47dv7dhin1.apps.googleusercontent.com

# --- CI/CD (GitHub Actions) ---
# .github/workflows/backend-image.yml pushes to GHCR using the built-in
# GITHUB_TOKEN — no extra secrets needed. Image: ghcr.io/<owner>/<repo>-backend
#
# Frontend build/deploy is not handled by GitHub Actions (e.g. if using
# Cloudflare Pages' native Git integration, which builds on push itself).
